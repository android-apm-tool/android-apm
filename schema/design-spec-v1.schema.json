{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned design cases, with review evidence separate from retrieval",
  "type": "object", "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": {"const": 1}, "snapshot": {"type": "object"},
    "cases": {"type": "array", "items": {"type": "object", "required": ["id", "name"], "properties": {
      "id": {"type": "string", "minLength": 1}, "name": {"type": "string"},
      "texts": {"type": "array", "items": {"type": "string"}}, "scenario": {"type": "object"},
      "review": {"type": "object", "properties": {"anchors": {"type": "array", "items": {
        "type": "object", "required": ["name", "source"], "properties": {"name": {"type": "string"},
          "source": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}, "line": {"type": "integer"}}}}
      }}, "conditionEvidenceIds": {"type": "array", "items": {"type": "string"}}}}
    }}}
  }
}
