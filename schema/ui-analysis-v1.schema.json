{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-backed UI analysis v1",
  "type": "object",
  "required": ["schemaVersion", "rulesVersion", "catalogFingerprint", "summary", "declarations", "boundaries", "usages", "scenarios", "limitations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "rulesVersion": {"type": "string"},
    "catalogFingerprint": {"type": "string", "minLength": 1},
    "summary": {"type": "object"},
    "declarations": {"type": "array", "items": {"type": "object", "required": ["id", "name", "bindingStatus", "primaryReason", "reasonCodes", "unusedStatus"], "properties": {
      "bindingStatus": {"enum": ["LINKED", "UNLINKED"]}, "unusedStatus": {"const": "NOT_PROVEN"},
      "reasonCodes": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidenceRefs": {"$ref": "#/$defs/refs"}
    }}},
    "boundaries": {"type": "array", "items": {"type": "object", "required": ["id", "bindingId", "kind", "definitionStatus", "resolution", "runtimeReachability"], "properties": {
      "runtimeReachability": {"const": "NOT_EVALUATED"}, "evidenceRefs": {"$ref": "#/$defs/refs"}
    }}},
    "usages": {"type": "array", "items": {"type": "object", "required": ["id", "declarationId", "bindingId", "boundaryIds", "role", "roleStatus", "certainty", "evidenceRefs"], "properties": {
      "certainty": {"enum": ["STRUCTURAL", "MAY"]}, "evidenceRefs": {"$ref": "#/$defs/refs"},
      "roleStatus": {"enum": ["UNCLASSIFIED", "RULE_INFERRED"]}
    }}},
    "scenarios": {"type": "array", "items": {"type": "object", "required": ["id", "boundaryId", "conditionRef", "feasibility", "evidenceRefs"], "properties": {
      "conditionRef": {"type": "string", "minLength": 1},
      "feasibility": {"const": "NOT_SOLVED"}, "evidenceRefs": {"$ref": "#/$defs/refs"}
    }}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
}
